# Reference made up cil for a app called myapp.
# can execute it's binary, connect to a port, and write logs and open etc.
(type myapp_t)
(type myapp_exec_t)
(type myapp_port_t)
(typeattributeset domain (myapp_t))
(typeattributeset exec_type (myapp_exec_t))
(typeattributeset file_type (myapp_exec_t))
(typeattributeset port_type (myapp_port_t))
(allow init_t myapp_exec_t (file (getattr open read execute)))
(allow init_t myapp_t (process (transition)))
(typetransition init_t myapp_exec_t process myapp_t)
(allow myapp_t myapp_exec_t (file (getattr open read execute entrypoint)))
(filecon "/usr/bin/myapp" file (system_u object_r myapp_exec_t ((s0) (s0))))
(portcon tcp 8080 (system_u object_r myapp_port_t ((s0) (s0))))
(allow myapp_t myapp_port_t (tcp_socket (name_bind)))
(type myapp_log_t)
(typeattributeset file_type (myapp_log_t))
(allow myapp_t myapp_log_t (file (getattr open append)))
(allow myapp_t myapp_log_t (dir (add_name write search)))
(filecon "/var/log/myapp(/.*)?" any" (system_u object_r myapp_log_t ((s0) (s0))))
(allow myapp_t etc_t (file (getattr open read)))
(allow myapp_t usr_t (file (getattr open read)))
